{
  "name": "setup",
  "version": "1.0.2",
  "description": "GitHub Action to setup nais CLI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist",
    "package": "pnpm run build",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "test:integration": "node test-dry-run.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:prepare": "pnpm run check && pnpm run build",
    "release:version": "changeset version",
    "release:publish": "pnpm run check && pnpm run build && bash scripts/release.sh",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test"
  },
  "keywords": [
    "actions",
    "nais",
    "cli",
    "setup",
    "linux"
  ],
  "author": "nais",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/http-client": "^4.0.1",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@changesets/changelog-github": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.9.1",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
